<div class="password-edit">
    {{#> profile-page}}
        {{> avatar-icon}}
        <div class="password-edit__form">
        {{#> profile-form buttonText="Сохранить"}}
            {{> profile-input
                label="Старый пароль"
                name="old-password"
                id="old-password"
                type="password"
                value="somepassword"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Новый пароль"
                name="new-password"
                id="new-password"
                type="password"
                value="somepassword"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Повторите новый пароль"
                name="new-password-confirm"
                id="new-password-confirm"
                type="password"
                value="somepassword"
                className="profile-form__fieldset"
            }}
        {{/profile-form}}
        </div>
    {{/profile-page}}
<div>