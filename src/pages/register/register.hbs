{{#> form-page }}
{{#> form
      title="Регистрация"
      buttonText="Зарегистрироваться"
      linkText="Войти"
      linkHref="../login/login.html"
}}
{{> input
        label="Почта"
        name="email"
        id="email"
        type="text"
        className="form__fieldset"
}}

{{> input
        label="Логин"
        name="login"
        id="login"
        type="text"
        className="form__fieldset"
}}

{{> input
        label="Имя"
        name="name"
        id="name"
        type="text"
        className="form__fieldset"
}}

{{> input
        label="Фамилия"
        name="surname"
        id="surname"
        type="text"
        className="form__fieldset"
}}

{{> input
        label="Телефон"
        name="phone"
        id="phone"
        type="text"
        className="form__fieldset"
}}

{{> input
        label="Пароль"
        name="password"
        id="password"
        type="password"
        className="form__fieldset"
}}

{{> input
        label="Пароль еще раз"
        name="password-confirm"
        id="password-confirm"
        type="password"
        className="form__fieldset"
        error="Пароли не совпадают"
}}
{{/form}}
{{/form-page}}
