<div class="profile-edit">
    {{#> profile-page}}
        {{> avatar-icon}}
        <div class="profile-edit__form">
        {{#> profile-form buttonText="Сохранить"}}
            {{> profile-input
                label="Почта"
                name="email"
                id="email"
                type="text"
                value="pochta@yandex.ru"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Логин"
                name="login"
                id="login"
                type="text"
                value="ivanivanov"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Имя"
                name="name"
                id="name"
                type="text"
                value="Иван"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Фамилия"
                name="surname"
                id="surname"
                type="text"
                value="Иванов"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Имя в чате"
                name="chat-name"
                id="chat-name"
                type="text"
                value="Иван"
                className="profile-form__fieldset"
            }}
            {{> profile-input
                label="Телефон"
                name="phone"
                id="phone"
                type="text"
                value="+7 (909) 967 30 30"
                className="profile-form__fieldset"
            }}
        {{/profile-form}}
        </div>
    {{/profile-page}}
<div>
