<div class="modal {{#if noPadding}}modal_type_no-padding{{/if}}">
  <button
    type="button"
    class="modal__close"
    aria-label="Закрыть модальное окно"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      pointer-events="none"
    >
      <path
        d="M6 6L18 18M18 6L6 18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  </button>
  <div class="modal__content">
    {{> @partial-block}}
  </div>
</div>
