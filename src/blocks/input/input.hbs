<fieldset class="input {{ className }} {{#if error}}input_state_error{{/if}}">
  <div class="input__wrapper">
    <label for="{{ id }}" class="input__label">
      {{ label }}
    </label>
    <input
      type="{{ type }}"
      name="{{ name }}"
      id="{{ id }}"
      class="input__input"
      value="{{ value }}"
    />
  </div>

  {{#if error}}
  <p class="input__error">{{ error }}</p>
  {{/if}}
</fieldset>
